          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "events"
        ],
        "title": "EventList"
      },
      "FaultConfig": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "fail_before_commit",
              "delay",
              "ambiguous"
            ],
            "title": "Mode",
            "default": "none"
          },
          "delay_ms": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "default": 50
          },
          "remaining": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Remaining",
            "default": 1
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "title": "FaultConfig"
      },
      "FaultState": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "fail_before_commit",
              "delay",
              "ambiguous"
            ],
            "title": "Mode"
          },
          "delay_ms": {
            "type": "integer",
            "title": "Delay Ms"
          },
          "remaining": {
            "type": "integer",
            "title": "Remaining"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "delay_ms",
          "remaining"
        ],
        "title": "FaultState"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
