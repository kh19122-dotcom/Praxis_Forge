  "components": {
    "schemas": {
      "Encounter": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "occurred_at": {
            "type": "string",
            "title": "Occurred At"
          },
          "kind": {
            "type": "string",
            "enum": [
              "intake",
              "follow_up",
              "review"
            ],
            "title": "Kind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "status": {
            "type": "string",
            "const": "completed",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "occurred_at",
          "kind",
          "summary",
          "status"
        ],
        "title": "Encounter"
      },
      "EncounterList": {
        "properties": {
          "seed": {
            "type": "string",
            "title": "Seed"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "encounters": {
            "items": {
              "$ref": "#/components/schemas/Encounter"
            },
            "type": "array",
            "title": "Encounters"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "patient_id",
          "encounters"
        ],
        "title": "EncounterList"
      },
      "Event": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "trace_id",
          "type"
        ],
        "title": "Event"
      },
      "EventList": {
        "properties": {
