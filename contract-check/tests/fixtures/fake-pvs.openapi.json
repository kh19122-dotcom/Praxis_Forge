          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "title": "Priority"
          },
          "status": {
            "type": "string",
            "const": "open",
            "title": "Status"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
