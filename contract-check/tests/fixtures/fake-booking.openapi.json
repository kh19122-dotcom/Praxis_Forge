  "components": {
    "schemas": {
      "Booking": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slot_id": {
            "type": "string",
            "title": "Slot Id"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "patient_ref": {
            "type": "string",
            "title": "Patient Ref"
          },
          "status": {
            "type": "string",
            "const": "confirmed",
            "title": "Status"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slot_id",
          "resource_id",
          "start",
          "end",
          "patient_ref",
          "status",
          "idempotency_key"
        ],
        "title": "Booking"
      },
      "BookingCreate": {
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1,
            "title": "Slot Id"
          },
          "patient_ref": {
            "type": "string",
            "pattern": "^synth-[a-z0-9-]+$",
            "title": "Patient Ref"
          }
        },
        "type": "object",
        "required": [
          "slot_id",
          "patient_ref"
        ],
        "title": "BookingCreate"
      },
      "Event": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "trace_id",
          "type"
        ],
        "title": "Event"
      },
      "EventList": {
        "properties": {
          "seed": {
            "type": "string",
            "title": "Seed"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "events"
        ],
        "title": "EventList"
      },
      "FaultConfig": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "fail_before_commit",
              "delay",
              "ambiguous"
            ],
            "title": "Mode",
            "default": "none"
          },
          "delay_ms": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "default": 50
          },
          "remaining": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Remaining",
            "default": 1
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "title": "FaultConfig"
      },
      "FaultState": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "fail_before_commit",
              "delay",
              "ambiguous"
            ],
            "title": "Mode"
          },
          "delay_ms": {
            "type": "integer",
            "title": "Delay Ms"
          },
          "remaining": {
            "type": "integer",
            "title": "Remaining"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "delay_ms",
          "remaining"
        ],
        "title": "FaultState"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "fake-booking",
            "title": "Service"
          },
          "seed": {
            "type": "string",
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "seed"
        ],
        "title": "Health"
      },
      "ResetResult": {
        "properties": {
          "status": {
            "type": "string",
            "const": "reset",
            "title": "Status"
          },
          "seed": {
            "type": "string",
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "status",
          "seed"
        ],
        "title": "ResetResult"
      },
      "Slot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "id",
          "resource_id",
          "start",
          "end",
          "available"
        ],
        "title": "Slot"
      },
      "SlotList": {
        "properties": {
          "seed": {
            "type": "string",
            "title": "Seed"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/Slot"
            },
            "type": "array",
            "title": "Slots"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "slots"
        ],
        "title": "SlotList"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
